{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::pythia-ml-artifacts"
    },
    {
      "Sid": "ReadWriteArtifactObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::pythia-ml-artifacts/artifacts/*"
    }
  ]
}
