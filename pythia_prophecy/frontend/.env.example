# Frontend build-time config (Vite bakes VITE_* at BUILD time — set before `npm run build`).

# --- Social login (Phase 2 web) ---
# Master switch. The social buttons only render when this is true AND a given
# provider is configured below. Leave false to ship the code dark.
VITE_SOCIAL_LOGIN_ENABLED=false

# Facebook — App ID from the Meta dashboard (App settings > Basic).
VITE_FACEBOOK_APP_ID=
VITE_FACEBOOK_GRAPH_VERSION=v19.0

# Google — the WEB OAuth client ID (ends in .apps.googleusercontent.com).
VITE_GOOGLE_CLIENT_ID=

# Apple — the Services ID (web client) + the Return URL registered on it.
VITE_APPLE_SERVICES_ID=
VITE_APPLE_REDIRECT_URI=https://seekingbeta.ai/login

# IMPORTANT: the backend must ALSO have SOCIAL_LOGIN_ENABLED=true and the matching
# provider secrets (FACEBOOK_APP_ID/SECRET, GOOGLE_OAUTH_CLIENT_IDS, APPLE_*),
# or the buttons will render but /api/auth/oauth/{provider} will 404/401.
